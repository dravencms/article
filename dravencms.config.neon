extensions:
    dravencms.article: Dravencms\Article\DI\ArticleExtension


nettrine.orm:
    managers:
        default:
            mapping:
                DravencmsModelArticle :
                    type: attributes
                    directories:
                        - %appDir%/../vendor/dravencms/article/src/Dravencms/Model/Article/Entities
                    namespace: Dravencms\Model\Article
