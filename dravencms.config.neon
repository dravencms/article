extensions:
    dravencms.article: Dravencms\Article\DI\ArticleExtension


nettrine.orm:
    managers:
        default:
            mapping:
                DravencmsModelArticle :
                    type: attributes
                    directories:
                        - %appDir%/../vendor/dravencms/article/src/Dravencms/Model/Article/Entities
                    namespace: Dravencms\Model\Article

files:
    variants:
        article-small:
            width: 140
            height: 100
            resizeMode: fit
        article-wide:
            width: 750
            height: 300
            resizeMode: exact
        article-related:
            width: 40
            height: 40
            resizeMode: shrink_only
        article-thumb:
            width: 100
            height: 100
            resizeMode: fit
        article-cover:
            width: 750
            height: 300
            resizeMode: fit_exact
