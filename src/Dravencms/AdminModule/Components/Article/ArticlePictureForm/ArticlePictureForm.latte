<form n:name="form" class="card">
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="position">{_"article.position"}</label>
                    <input n:name="position" class="form-control">
                </div>
            </div><!-- col-sm-12 -->
        </div><!-- row -->
        <div class="col-sm-12 mb-3">{label articlePicture /}{input articlePicture}</div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isPrimary" class="form-check-input"> <span class="form-check-label">{_"article.isPrimary"}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isActive" class="form-check-input"> <span class="form-check-label">{_"article.isActive"}</span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <input type="submit" n:name="send" class="btn btn-success button" value="{_"article.save"}">
    </div>
</form>